# .env
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it's in .gitignore.
#
# To generate SECRET_KEY:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# To generate ENCRYPTION_KEY:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=MindGuard API
ENVIRONMENT=development
DEBUG=true

# ── Database ──────────────────────────────────────────────────────────────────
# Docker: the host is "db" (the Docker service name)
# Local (no Docker): change "db" to "localhost"
DATABASE_URL=postgresql+asyncpg://mindguard:mindguard@db:5432/mindguard
REDIS_URL=redis://redis:6379/0

# ── Security (GENERATE NEW VALUES — don't use these placeholders) ─────────────
SECRET_KEY=CHANGE_ME_generate_with_python_secrets_token_hex_32
ENCRYPTION_KEY=CHANGE_ME_generate_with_cryptography_Fernet_generate_key

# ── AI ────────────────────────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
